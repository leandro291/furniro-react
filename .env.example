# Copiar a .env (local) y cargar las mismas VITE_* en Vercel (Settings > Environment Variables).
# Vite embebe las VITE_* en el build: si se cambian en Vercel hay que redeployar.

# --- Fuente de datos -------------------------------------------------------
# "furniro" = backend Django propio | "fakestore" = fakestoreapi.com (default si falta)
VITE_API_SOURCE=furniro
VITE_FAKESTORE_BASE_URL=https://fakestoreapi.com

# URL del backend, sin barra final.
#   Producción (Vercel): https://furniro-ecommerce-backend-1h5m.onrender.com
#   Local con proxy de Vite: dejar vacío (las llamadas /api las reenvía DEV_API_PROXY)
VITE_FURNIRO_BASE_URL=https://furniro-ecommerce-backend-1h5m.onrender.com

# Solo desarrollo, NO va a Vercel. Backend al que `npm run dev` reenvía /api (evita CORS).
# Requiere VITE_FURNIRO_BASE_URL vacío.
#   Backend local: http://localhost:8000
#   Backend Render: https://furniro-ecommerce-backend-1h5m.onrender.com
# DEV_API_PROXY=http://localhost:8000

# --- EmailJS (formulario de contacto) --------------------------------------
# Panel de emailjs.com: Email Services (Service ID), Email Templates (Template ID),
# Account > General (Public Key). Plantilla con {{name}} {{email}} {{subject}} {{message}}.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
